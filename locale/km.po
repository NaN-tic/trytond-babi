msgstr "ធាតុតម្រៀបត្រូវបានបង្កើតដោយស្វ័យប្រវត្តិ"

msgctxt "model:ir.message,text:cannot_remove_order_entry"
msgid "Order entries are deleted automatically"
msgstr "ធាតុតម្រៀបត្រូវបានលុបដោយស្វ័យប្រវត្តិ"

#, python-format
msgctxt "model:ir.message,text:create_data_exception"
msgid "An Exception Occurred: %(error)s"
msgstr "មានករណីលើកលែង៖ %(error)s"

#, python-format
msgctxt "model:ir.message,text:create_data_exception_dimension"
msgid ""
"An Exception Occurred: On dimensions, with expression %(expression)s on record %(record)s.\n"
"Exception: %(error)s"
msgstr ""
"មានករណីលើកលែងក្នុងវិមាត្រ ដោយប្រើកន្សោម %(expression)s លើកំណត់ត្រា %(record)s។\n"
"ករណីលើកលែង៖ %(error)s"

#, python-format
msgctxt "model:ir.message,text:create_data_exception_measures"
msgid ""
"An Exception Occurred: On measures, with expression %(expression)s on record %(record)s.\n"
"Exception: %(error)s"
msgstr ""
"មានករណីលើកលែងក្នុងរង្វាស់ ដោយប្រើកន្សោម %(expression)s លើកំណត់ត្រា %(record)s។\n"
"ករណីលើកលែង៖ %(error)s"

msgctxt "model:ir.message,text:false"
msgid "False"
msgstr "មិនពិត"

#, python-format
msgctxt "model:ir.message,text:filter_parameters"
msgid ""
"Execution \"%(execution)s\" has filter parameters and you did not provide any"
" of them. Please execute it from the menu."
msgstr ""
"ការដំណើរការ «%(execution)s» មានប៉ារ៉ាម៉ែត្រតម្រង "
"ហើយអ្នកមិនទាន់ផ្ដល់ប៉ារ៉ាម៉ែត្រណាមួយទេ។ សូមដំណើរការពីម៉ឺនុយ។"

#, python-format
msgctxt "model:ir.message,text:invalid_parameters"
msgid ""
"Key \"%(key)s\" in domain, python expression or context is not in the "
"parameters from filter of report."
msgstr ""
"កូនសោ «%(key)s» ក្នុងលក្ខខណ្ឌតម្រង កន្សោម Python ឬបរិបទ "
"មិនមានក្នុងប៉ារ៉ាម៉ែត្រតម្រងរបាយការណ៍ទេ។"

#, python-format
msgctxt "model:ir.message,text:msg_chart_limit"
msgid ""
"The number of records \"%(count)s\" exceeds the limit \"%(limit)s\" for chart"
" \"%(widget)s\". You must either narrow the query or increase the limit."
msgstr ""
"ចំនួនកំណត់ត្រា «%(count)s» លើសកម្រិត «%(limit)s» សម្រាប់គំនូសតាង "
"«%(widget)s»។ សូមបង្រួមសំណួរទិន្នន័យ ឬបង្កើនកម្រិត។"

#, python-format
msgctxt "model:ir.message,text:msg_circular_dependency"
msgid ""
"Circular dependency with the following table sequence:\n"
"\n"
"\"%(sequence)s\""
msgstr ""
"ភាពអាស្រ័យជារង្វង់ក្នុងលំដាប់តារាងខាងក្រោម៖\n"
"\n"
"«%(sequence)s»"

#, python-format
msgctxt "model:ir.message,text:msg_compute_table_exception"
msgid ""
"An exception occurred while computing the value for field \"%(field)s\" in table \"%(table)s\", record \"%(record)s\". The error was:\n"
"\n"
"%(error)s"
msgstr ""
"មានកំហុសពេលគណនាតម្លៃសម្រាប់វាល «%(field)s» ក្នុងតារាង «%(table)s» កំណត់ត្រា «%(record)s»។ កំហុស៖\n"
"\n"
"%(error)s"

msgctxt "model:ir.message,text:msg_copy"
msgid "copy"
msgstr "ច្បាប់ចម្លង"

#, python-format
msgctxt "model:ir.message,text:msg_error_obtaining_records"
msgid ""
"An error occurred while obtaining the records for table \"%(table)s\":\n"
"\n"
"%(error)s"
msgstr ""
"មានកំហុសពេលទាញយកកំណត់ត្រាសម្រាប់តារាង «%(table)s»៖\n"
"\n"
"%(error)s"

#, python-format
msgctxt "model:ir.message,text:msg_invalid_aggregate"
msgid ""
"Aggregates \"Sum\" and \"Average\" are not supported in non numeric fields in"
" parameter \"%(parameter)s\" in widget \"%(widget)s\"."
msgstr ""
"ការប្រមូលផ្ដុំ «ផលបូក» និង «មធ្យម» "
"មិនគាំទ្រវាលដែលមិនមែនជាលេខក្នុងប៉ារ៉ាម៉ែត្រ «%(parameter)s» នៃធាតុបង្ហាញ "
"«%(widget)s» ទេ។"

#, python-format
msgctxt "model:ir.message,text:msg_invalid_field_internal_name"
msgid "Invalid internal name \"%(internal_name)s\" in field \"%(field)s\"."
msgstr "ឈ្មោះផ្ទៃក្នុង «%(internal_name)s» ក្នុងវាល «%(field)s» មិនត្រឹមត្រូវ។"

#, python-format
msgctxt "model:ir.message,text:msg_invalid_field_internal_name_first_character"
msgid ""
"Invalid first character in internal name \"%(internal_name)s\" in field "
"\"%(field)s\"."
msgstr ""
"តួអក្សរដំបូងក្នុងឈ្មោះផ្ទៃក្នុង «%(internal_name)s» នៃវាល «%(field)s» "
"មិនត្រឹមត្រូវ។"

#, python-format
msgctxt "model:ir.message,text:msg_invalid_parameter_type"
msgid ""
"Parameter \"%(parameter)s\" is not valid in widget \"%(widget)s\". Only the "
"following types can be used: \"%(types)s\"."
msgstr ""
"ប៉ារ៉ាម៉ែត្រ «%(parameter)s» មិនត្រឹមត្រូវក្នុងធាតុបង្ហាញ «%(widget)s»។ "
"អាចប្រើតែប្រភេទខាងក្រោម៖ «%(types)s»។"

#, python-format
msgctxt "model:ir.message,text:msg_invalid_table_internal_name"
msgid "Invalid internal name \"%(internal_name)s\" in table \"%(table)s\"."
msgstr ""
"ឈ្មោះផ្ទៃក្នុង «%(internal_name)s» ក្នុងតារាង «%(table)s» មិនត្រឹមត្រូវ។"

#, python-format
msgctxt "model:ir.message,text:msg_invalid_table_internal_name_first_character"
msgid ""
"Invalid first character in internal name \"%(internal_name)s\" in table "
"\"%(table)s\"."
msgstr ""
"តួអក្សរដំបូងក្នុងឈ្មោះផ្ទៃក្នុង «%(internal_name)s» នៃតារាង «%(table)s» "
"មិនត្រឹមត្រូវ។"

msgctxt "model:ir.message,text:msg_no"
msgid "No"
msgstr "ទេ"

#, python-format
msgctxt "model:ir.message,text:msg_not_converted"
msgid ""
"Some field of the field %(field)s is not numeric and cannot be converted. "
"Please check the query."
msgstr ""
"តម្លៃមួយក្នុងវាល %(field)s មិនមែនជាលេខ ហើយមិនអាចបម្លែងបានទេ។ "
"សូមពិនិត្យសំណួរទិន្នន័យ។"

#, python-format
msgctxt "model:ir.message,text:msg_not_enough_parameters"
msgid ""
"There must be at least \"%(min)s\" parameters of type \"%(type)s\" in "
"\"%(widget)s\"."
msgstr ""
"ត្រូវមានប៉ារ៉ាម៉ែត្រប្រភេទ «%(type)s» យ៉ាងហោចណាស់ «%(min)s» ក្នុង "
"«%(widget)s»។"

#, python-format
msgctxt "model:ir.message,text:msg_only_one_table_with_parameters"
msgid ""
"Table \"%(table)s\" requires parameters but you tried to compute more than "
"one table at once. Tables with parameters must be computed individually."
msgstr ""
"តារាង «%(table)s» ត្រូវការប៉ារ៉ាម៉ែត្រ "
"ប៉ុន្តែអ្នកបានព្យាយាមគណនាតារាងច្រើនក្នុងពេលតែមួយ។ "
"ត្រូវគណនាតារាងដែលមានប៉ារ៉ាម៉ែត្រម្តងមួយ។"

msgctxt "model:ir.message,text:msg_open_warning_single"
msgid ""
"You can only open records for several warnings if they are all of the same "
"type."
msgstr ""
"អាចបើកកំណត់ត្រាសម្រាប់ការព្រមានច្រើនបាន "
"លុះត្រាតែការព្រមានទាំងអស់មានប្រភេទដូចគ្នា។"

msgctxt "model:ir.message,text:msg_pivots_filename"
msgid "pivot-tables"
msgstr "តារាងបង្វិល"

#, python-format
msgctxt "model:ir.message,text:msg_render_report_columns"
msgid "Print report \"%(report)s\" has dimensions in columns and is not supported."
msgstr "មិនគាំទ្រការបោះពុម្ពរបាយការណ៍ «%(report)s» ដែលមានវិមាត្រក្នុងជួរឈរទេ។"

#, python-format
msgctxt "model:ir.message,text:msg_report_failed"
msgid "Calculation of report \"%(report)s\" failed."
msgstr "ការគណនារបាយការណ៍ «%(report)s» បានបរាជ័យ។"

#, python-format
msgctxt "model:ir.message,text:msg_report_successful"
msgid "Report \"%(report)s\" successfully calculated."
msgstr "គណនារបាយការណ៍ «%(report)s» បានជោគជ័យ។"

#, python-format
msgctxt "model:ir.message,text:msg_report_timeout"
msgid ""
"Calculation of report \"%(report)s\" aborted because it took more thant "
"%(seconds)s to compute."
msgstr "ការគណនារបាយការណ៍ «%(report)s» បានបញ្ឈប់ ព្រោះចំណាយពេលលើស %(seconds)s។"

#, python-format
msgctxt "model:ir.message,text:msg_table_failed"
msgid "Computation of \"%(table)s\" failed."
msgstr "ការគណនា «%(table)s» បានបរាជ័យ។"

msgctxt "model:ir.message,text:msg_table_internal_name_unique"
msgid "Table's internal name must be unique."
msgstr "ឈ្មោះផ្ទៃក្នុងរបស់តារាងត្រូវមានតែមួយគត់។"

#, python-format
msgctxt "model:ir.message,text:msg_table_limit"
msgid "(limited to %(number)s)"
msgstr "(កំណត់ត្រឹម %(number)s)"

#, python-format
msgctxt "model:ir.message,text:msg_table_no_fields"
msgid "Table \"%(table)s\" cannot be computed because it has no fields."
msgstr "មិនអាចគណនាតារាង «%(table)s» បានទេ ព្រោះវាគ្មានវាល។"

#, python-format
msgctxt "model:ir.message,text:msg_table_rows"
msgid "%(count)s rows"
msgstr "%(count)s ជួរដេក"

#, python-format
msgctxt "model:ir.message,text:msg_table_successful"
msgid "Computation of \"%(table)s\" finished successfully."
msgstr "ការគណនា «%(table)s» បានបញ្ចប់ដោយជោគជ័យ។"

msgctxt "model:ir.message,text:msg_tables_filename"
msgid "tables"
msgstr "តារាង"

msgctxt "model:ir.message,text:msg_tables_not_created"
msgid "Warning: tables could not be created. Please check your query."
msgstr "ការព្រមាន៖ មិនអាចបង្កើតតារាងបានទេ។ សូមពិនិត្យសំណួរទិន្នន័យរបស់អ្នក។"

#, python-format
msgctxt "model:ir.message,text:msg_too_many_parameters"
msgid ""
"There can not be more than \"%(max)s\" parameters of type \"%(type)s\" in "
"\"%(widget)s\"."
msgstr ""
"មិនអាចមានប៉ារ៉ាម៉ែត្រប្រភេទ «%(type)s» លើសពី «%(max)s» ក្នុង «%(widget)s»។"

msgctxt "model:ir.message,text:msg_waiting_for_computation"
msgid "Waiting for computation of table to finish."
msgstr "កំពុងរង់ចាំការគណនាតារាងបញ្ចប់។"

#, python-format
msgctxt "model:ir.message,text:msg_widget_help"
msgid ""
"The following is the list of valid parameter types wth the number of minimum and maximum occurrences allowed:\n"
"\n"
"%(list)s"
msgstr ""
"ខាងក្រោមនេះជាបញ្ជីប្រភេទប៉ារ៉ាម៉ែត្រដែលអាចប្រើបាន ព្រមទាំងចំនួនអប្បបរមា និងអតិបរមាដែលអនុញ្ញាត៖\n"
"\n"
"%(list)s"

#, python-format
msgctxt "model:ir.message,text:msg_wrong_info"
msgid ""
"The information returned from the field %(field)s is not correct or you don't have enough permissions to access it.             Records found by query: %(query_count)s\n"
"            Records found by Model: %(model_query_count)s\n"
"            "
msgstr ""
"ព័ត៌មានដែលវាល %(field)s ផ្ដល់មិនត្រឹមត្រូវ ឬអ្នកមិនមានសិទ្ធិគ្រប់គ្រាន់ដើម្បីចូលប្រើវា។             កំណត់ត្រាដែលរកឃើញតាមសំណួរទិន្នន័យ៖ %(query_count)s\n"
"            កំណត់ត្រាដែលរកឃើញតាមម៉ូដែល៖ %(model_query_count)s\n"
"            "

msgctxt "model:ir.message,text:msg_yes"
msgid "Yes"
msgstr "បាទ/ចាស"

#, python-format
msgctxt "model:ir.message,text:no_dimensions"
msgid "Report \"%(report)s\" has no dimensions. At least one is needed."
msgstr "របាយការណ៍ «%(report)s» មិនមានវិមាត្រ។ ត្រូវមានយ៉ាងហោចណាស់មួយ។"

msgctxt "model:ir.message,text:no_execution"
msgid ""
"No execution found for current record. Execute the update data wizard in "
"order to create one."
msgstr ""
"រកមិនឃើញការដំណើរការសម្រាប់កំណត់ត្រាបច្ចុប្បន្នទេ។ "
"បើកជំនួយការធ្វើបច្ចុប្បន្នភាពទិន្នន័យដើម្បីបង្កើត។"

#, python-format
msgctxt "model:ir.message,text:no_measures"
msgid "Report \"%(report)s\" has no measures. At least one is needed."
msgstr "របាយការណ៍ «%(report)s» មិនមានរង្វាស់។ ត្រូវមានយ៉ាងហោចណាស់មួយ។"

#, python-format
msgctxt "model:ir.message,text:no_menus"
msgid ""
"No menus found for report %(report)s. In order to view its data you must "
"create menu entries."
msgstr ""
"រកមិនឃើញម៉ឺនុយសម្រាប់របាយការណ៍ %(report)s ទេ។ "
"បង្កើតធាតុម៉ឺនុយដើម្បីមើលទិន្នន័យរបស់របាយការណ៍នេះ។"

msgctxt "model:ir.message,text:no_report"
msgid "No report found for current execution"
msgstr "រកមិនឃើញរបាយការណ៍សម្រាប់ការដំណើរការបច្ចុប្បន្ន"

msgctxt "model:ir.message,text:one_measure_in_pie_charts"
msgid "Only one measure can be used in pie charts"
msgstr "អាចប្រើរង្វាស់តែមួយក្នុងគំនូសតាងរាងចំណិត។"

#, python-format
msgctxt "model:ir.message,text:parameter_not_found"
msgid ""
"Parameter \"%(parameter)s\" not found in Domain, Python Expression nor "
"Context of filter \"%(filter)s\"."
msgstr ""
"រកមិនឃើញប៉ារ៉ាម៉ែត្រ «%(parameter)s» ក្នុងលក្ខខណ្ឌតម្រង កន្សោម Python "
"ឬបរិបទនៃតម្រង «%(filter)s»។"

#, python-format
msgctxt "model:ir.message,text:report_modification_warning"
msgid ""
"Report \"%(report)s\" will be renamed, but if you want to also rename the "
"menus you should create the menus again. Are you sure you want to continue "
"with this action?"
msgstr ""
