#, python-format
msgctxt "model:ir.message,text:msg_not_converted"
msgid ""
"Some field of the field %(field)s is not numeric and cannot be converted. "
"Please check the query."
msgstr ""
"A(z) %(field)s mező egyes értékei nem numerikusak és nem alakíthatók át. "
"Ellenőrizze a lekérdezést."

#, python-format
msgctxt "model:ir.message,text:msg_not_enough_parameters"
