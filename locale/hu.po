"\n"
"„%(sequence)s”"

#, python-format
msgctxt "model:ir.message,text:msg_compute_table_exception"
msgid ""
"An exception occurred while computing the value for field \"%(field)s\" in table \"%(table)s\", record \"%(record)s\". The error was:\n"
"\n"
"%(error)s"
