msgstr "表“%(table)s”的内部名称“%(internal_name)s”无效。"

#, python-format
msgctxt ""
"model:ir.message,text:msg_invalid_table_internal_name_first_character"
msgid ""
"Invalid first character in internal name \"%(internal_name)s\" in table "
"\"%(table)s\"."
msgstr "表“%(table)s”的内部名称“%(internal_name)s”的首字符无效。"

msgctxt "model:ir.message,text:msg_no"
msgid "No"
msgstr "否"

#, python-format
msgctxt "model:ir.message,text:msg_not_converted"
msgid ""
"Some field of the field %(field)s is not numeric and cannot be converted. "
"Please check the query."
msgstr "字段 %(field)s 中有些值不是数值且无法转换。请检查查询。"

#, python-format
msgctxt "model:ir.message,text:msg_not_enough_parameters"
msgid ""
"There must be at least \"%(min)s\" parameters of type \"%(type)s\" in "
"\"%(widget)s\"."
msgstr "“%(widget)s”中至少需要“%(min)s”个“%(type)s”类型的参数。"

#, python-format
msgctxt "model:ir.message,text:msg_only_one_table_with_parameters"
msgid ""
"Table \"%(table)s\" requires parameters but you tried to compute more than "
"one table at once. Tables with parameters must be computed individually."
msgstr "表“%(table)s”需要参数，但您尝试同时计算多个表。带参数的表必须单独计算。"

msgctxt "model:ir.message,text:msg_open_warning_single"
msgid ""
"You can only open records for several warnings if they are all of the same "
"type."
msgstr "仅当多个警告均属于同一类型时，才能同时打开其记录。"

msgctxt "model:ir.message,text:msg_pivots_filename"
msgid "pivot-tables"
msgstr "pivot-tables"

#, python-format
msgctxt "model:ir.message,text:msg_render_report_columns"
msgid ""
"Print report \"%(report)s\" has dimensions in columns and is not supported."
msgstr "报表“%(report)s”包含列维度，不支持打印。"

#, python-format
msgctxt "model:ir.message,text:msg_report_failed"
msgid "Calculation of report \"%(report)s\" failed."
msgstr "报表“%(report)s”计算失败。"

#, python-format
msgctxt "model:ir.message,text:msg_report_successful"
msgid "Report \"%(report)s\" successfully calculated."
msgstr "报表“%(report)s”计算成功。"

#, python-format
msgctxt "model:ir.message,text:msg_report_timeout"
msgid ""
"Calculation of report \"%(report)s\" aborted because it took more thant "
"%(seconds)s to compute."
msgstr "报表“%(report)s”的计算耗时超过 %(seconds)s，已中止。"

#, python-format
msgctxt "model:ir.message,text:msg_table_failed"
msgid "Computation of \"%(table)s\" failed."
msgstr "“%(table)s”计算失败。"

msgctxt "model:ir.message,text:msg_table_internal_name_unique"
msgid "Table's internal name must be unique."
msgstr "表的内部名称必须唯一。"

#, python-format
msgctxt "model:ir.message,text:msg_table_limit"
msgid "(limited to %(number)s)"
msgstr "（最多 %(number)s 条）"

#, python-format
msgctxt "model:ir.message,text:msg_table_no_fields"
msgid "Table \"%(table)s\" cannot be computed because it has no fields."
msgstr "表“%(table)s”没有字段，无法计算。"

#, python-format
msgctxt "model:ir.message,text:msg_table_rows"
msgid "%(count)s rows"
msgstr "%(count)s 行"

#, python-format
msgctxt "model:ir.message,text:msg_table_successful"
msgid "Computation of \"%(table)s\" finished successfully."
msgstr "“%(table)s”计算成功。"

msgctxt "model:ir.message,text:msg_tables_filename"
msgid "tables"
msgstr "表"

msgctxt "model:ir.message,text:msg_tables_not_created"
msgid "Warning: tables could not be created. Please check your query."
msgstr "警告：无法创建表。请检查查询。"

#, python-format
msgctxt "model:ir.message,text:msg_too_many_parameters"
msgid ""
"There can not be more than \"%(max)s\" parameters of type \"%(type)s\" in "
"\"%(widget)s\"."
msgstr "“%(widget)s”中“%(type)s”类型的参数不能超过“%(max)s”个。"

msgctxt "model:ir.message,text:msg_waiting_for_computation"
msgid "Waiting for computation of table to finish."
msgstr "正在等待表计算完成。"

#, python-format
msgctxt "model:ir.message,text:msg_widget_help"
msgid ""
"The following is the list of valid parameter types wth the number of minimum and maximum occurrences allowed:\n"
"\n"
"%(list)s"
msgstr ""
"以下为有效参数类型及其允许的最少和最多出现次数：\n"
"\n"
"%(list)s"

#, python-format
msgctxt "model:ir.message,text:msg_wrong_info"
msgid ""
"The information returned from the field %(field)s is not correct or you don't have enough permissions to access it.             Records found by query: %(query_count)s\n"
"            Records found by Model: %(model_query_count)s\n"
"            "
msgstr ""
"字段 %(field)s 返回的信息不正确，或您没有足够的访问权限。             查询找到的记录数：%(query_count)s\n"
"            模型找到的记录数：%(model_query_count)s\n"
"            "

msgctxt "model:ir.message,text:msg_yes"
msgid "Yes"
msgstr "是"

#, python-format
msgctxt "model:ir.message,text:no_dimensions"
msgid "Report \"%(report)s\" has no dimensions. At least one is needed."
msgstr "报表“%(report)s”没有维度。至少需要一个维度。"

msgctxt "model:ir.message,text:no_execution"
msgid ""
"No execution found for current record. Execute the update data wizard in "
"order to create one."
msgstr "未找到当前记录的执行记录。请运行更新数据向导以创建执行记录。"

#, python-format
msgctxt "model:ir.message,text:no_measures"
msgid "Report \"%(report)s\" has no measures. At least one is needed."
msgstr "报表“%(report)s”没有度量。至少需要一个度量。"

#, python-format
msgctxt "model:ir.message,text:no_menus"
msgid ""
"No menus found for report %(report)s. In order to view its data you must "
"create menu entries."
msgstr "未找到报表 %(report)s 的菜单。必须创建菜单项才能查看数据。"

msgctxt "model:ir.message,text:no_report"
msgid "No report found for current execution"
msgstr "未找到当前执行对应的报表"

msgctxt "model:ir.message,text:one_measure_in_pie_charts"
msgid "Only one measure can be used in pie charts"
msgstr "饼图只能使用一个度量"

#, python-format
msgctxt "model:ir.message,text:parameter_not_found"
msgid ""
"Parameter \"%(parameter)s\" not found in Domain, Python Expression nor "
"Context of filter \"%(filter)s\"."
msgstr "在筛选器“%(filter)s”的筛选条件、Python 表达式和上下文中均未找到参数“%(parameter)s”。"

#, python-format
msgctxt "model:ir.message,text:report_modification_warning"
msgid ""
"Report \"%(report)s\" will be renamed, but if you want to also rename the "
"menus you should create the menus again. Are you sure you want to continue "
"with this action?"
msgstr "将重命名报表“%(report)s”。如果也要重命名菜单，请重新创建菜单。确定要继续此操作吗？"

#, python-format
msgctxt "model:ir.message,text:report_not_exists"
msgid ""
"Report \"%(report)s\" no longer exists or you do not have the rights to "
